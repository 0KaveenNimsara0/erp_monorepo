# Node / Frontend Dependencies
node_modules/
frontend/node_modules/
.npm
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PHP / Backend Dependencies
vendor/
backend/vendor/
composer.phar
backend/composer.phar

# Environment files (Secrets & Local Credentials)
.env
.env.*
!.env.example
backend/.env
!backend/.env.example
frontend/.env.local
frontend/.env.production
frontend/.env.staging
!frontend/.env.local.example

# Next.js build output
.next/
frontend/.next/
frontend/out/
frontend/build/

# CodeIgniter 4 Writable Cache, Logs, Sessions, Uploads, Debugbar
writable/cache/*
!writable/cache/.gitkeep
writable/logs/*
!writable/logs/.gitkeep
writable/session/*
!writable/session/.gitkeep
writable/uploads/*
!writable/uploads/.gitkeep
writable/debugbar/*
!writable/debugbar/.gitkeep

backend/writable/cache/*
!backend/writable/cache/.gitkeep
backend/writable/logs/*
!backend/writable/logs/.gitkeep
backend/writable/session/*
!backend/writable/session/.gitkeep
backend/writable/uploads/*
!backend/writable/uploads/.gitkeep
backend/writable/debugbar/*
!backend/writable/debugbar/.gitkeep

# TypeScript build / Next.js cache
*.tsbuildinfo
next-env.d.ts

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor workspace configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
